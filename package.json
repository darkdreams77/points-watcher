{
  "name": "points-watcher",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "test:cookies": "ts-node src/tests/test-cookie.ts",
    "test:backup": "ts-node src/tests/test-backup.ts",
    "scrape": "ts-node src/index.ts",
    "scrape:local": "ts-node src/index.ts ENV=local",
    "scrape:dry": "ts-node src/local/scrape-to-file.ts",
    "dev:server": "ts-node src/server.ts",
    "dev:frontend": "cd frontend && pnpm dev",
    "backup:local": "ts-node src/local/manual-backup.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@prisma/config": "^7.0.1",
    "axios": "^1.7.0",
    "axios-cookiejar-support": "^6.0.5",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "@types/pg": "^8.15.6",
    "prisma": "^7.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
